{
  "name": "research-pal-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../web run build",
    "sync": "npm run build:web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "icons": "python scripts/make-android-icons.py",
    "phone": "npm --prefix ../web run phone",
    "test": "npm --prefix ../web run test:mobile"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
