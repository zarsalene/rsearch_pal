# ---- Required ----
# The password you type on the login page.
APP_PASSWORD=change-me-to-a-long-password
# Random secret that signs the login token. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Address of your frontend (Vercel). No trailing slash. Several values: separate with commas.
FRONTEND_ORIGIN=http://localhost:5173

# ---- AI providers: gemini | groq | openrouter | ollama ----
# The first one is the default. If it fails (error, free limit, outage), the server uses the providers in LLM_FALLBACK, in order.
# The next request tries the default again. A provider without a key is skipped.
LLM_PROVIDER=gemini
LLM_FALLBACK=groq
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Model of each provider (optional)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
# After an error, skip that provider for this many seconds (0 = never skip)
# LLM_COOLDOWN=60
# Maximum characters of paper text that you send in one request (free tiers have small limits)
# LLM_CONTEXT_CHARS=90000

# ---- Storage ----
# The SQLite file, the PDFs and the search index are saved in this folder.
# A relative path starts from the folder where you start the server (backend/).
DATA_DIR=./data
# Embeddings for search and links: default (MiniLM, runs locally, about 400 MB memory)
# | gemini (Gemini API, free, low memory, chunk text goes to Google) | hash (tests only)
EMBEDDING_BACKEND=default
# Minimum similarity to link two papers (0 to 1)
LINK_THRESHOLD=0.40

# ---- Supabase (multi-user mode). Leave SUPABASE_URL empty for one-user mode (password + SQLite). ----
# With SUPABASE_URL set: email login, Postgres, and EMBEDDING_BACKEND=gemini are required.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
# ALLOWED_EMAILS=you@example.com,friend@example.com

# ---- Find papers ----
# Your email. Unpaywall needs it to find free PDFs (the rule of Unpaywall). OpenAlex also uses it. It goes only to those two services.
CONTACT_EMAIL=
